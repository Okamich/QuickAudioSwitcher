<Window x:Class="QuickAudioSwitcher.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки QuickAudioSwitcher"
        Icon="/Resources/app.ico"
        Width="820" Height="640"
        MinHeight="520" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource StudioBgDarkBrush}"
        Foreground="{DynamicResource StudioTextPrimaryBrush}"
        FontFamily="Segoe UI, Segoe UI Variable Text">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Studio Header -->
        <Border Grid.Row="0" Margin="0,0,0,14" Padding="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource StudioCardHoverBrush}"
                        BorderBrush="{DynamicResource StudioBorderHighlightBrush}"
                        BorderThickness="1"
                        CornerRadius="8" Width="44" Height="44" Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="🎛" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeaderTitle" Text="Конфигурация аудиовыходов и управления"
                               FontSize="17" FontWeight="Bold" Foreground="{DynamicResource StudioTextPrimaryBrush}" />
                    <TextBlock x:Name="TxtHeaderSubtitle" Text="Отметьте выходы для ротации, задайте понятные псевдонимы (например, «Монитор Левый») и протестируйте звук кнопкой «▶ Тест»."
                               FontSize="12" Foreground="{DynamicResource StudioTextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Devices List Container -->
        <Border Grid.Row="1" Background="{DynamicResource StudioContainerBgBrush}"
                BorderBrush="{DynamicResource StudioBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="10">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="10,4,10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtColRotation" Grid.Column="0" Text="РОТАЦИЯ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource StudioTextMutedBrush}" />
                    <TextBlock x:Name="TxtColDevice" Grid.Column="1" Text="УСТРОЙСТВО И ДРАЙВЕР" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource StudioTextMutedBrush}" />
                    <TextBlock x:Name="TxtColCustomName" Grid.Column="2" Text="ПОЛЬЗОВАТЕЛЬСКОЕ ИМЯ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource StudioTextMutedBrush}" />
                    <TextBlock x:Name="TxtColTest" Grid.Column="3" Text="ПРОВЕРКА" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource StudioTextMutedBrush}" HorizontalAlignment="Center" />
                </Grid>

                <Separator DockPanel.Dock="Top" Background="{DynamicResource StudioBorderBrush}" Margin="0,0,0,8" />

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PnlDeviceRows" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Settings 3-Column Panel (Hotkey | System | Appearance) -->
        <Border Grid.Row="2" Background="{DynamicResource StudioContainerBgBrush}"
                BorderBrush="{DynamicResource StudioBorderBrush}"
                BorderThickness="1" CornerRadius="8" Margin="0,14,0,14" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.1*" />
                </Grid.ColumnDefinitions>

                <!-- 1. Hotkey block -->
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="⌨" FontSize="14" Foreground="{DynamicResource StudioAccentCyanBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtHotkeyTitle" Text="Глобальный хоткей / Мышь" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource StudioTextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <CheckBox x:Name="ChkEnableHotkey" Content="Включить быстрое переключение" IsChecked="True"
                              Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnRecordHotkey"
                                Content="⌨ Ctrl + Alt + A"
                                Style="{StaticResource ModernButtonStyle}"
                                Padding="10,8" FontSize="13" FontWeight="SemiBold"
                                Background="{DynamicResource StudioCardHoverBrush}"
                                BorderBrush="{DynamicResource StudioAccentCyanBrush}"
                                Foreground="{DynamicResource StudioAccentCyanBrush}"
                                HorizontalContentAlignment="Center"
                                Click="BtnRecordHotkey_Click" />

                        <Button x:Name="BtnResetHotkey" Grid.Column="1"
                                Content="Сброс"
                                Style="{StaticResource ModernButtonStyle}"
                                Padding="8,8" FontSize="12" Margin="6,0,0,0"
                                ToolTip="Сбросить на значение по умолчанию"
                                Click="BtnResetHotkey_Click" />
                    </Grid>

                    <TextBlock x:Name="TxtHotkeyHint"
                               Text="Кликните на поле выше и нажмите любую комбинацию клавиш или боковую кнопку мыши (Mouse 4 / Mouse 5)."
                               FontSize="11" Foreground="{DynamicResource StudioTextMutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Separator 1 -->
                <Rectangle Grid.Column="1" Fill="{DynamicResource StudioBorderBrush}" Width="1" HorizontalAlignment="Center" Margin="0,2" />

                <!-- 2. System block -->
                <StackPanel Grid.Column="2">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🚀" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtSystemTitle" Text="Системная интеграция" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource StudioTextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <CheckBox x:Name="ChkAutostart" Content="Запускать вместе с Windows (автозапуск)"
                              Margin="0,0,0,8" />

                    <CheckBox x:Name="ChkShowOsd" Content="Показывать OSD-плашку на экране при смене"
                              IsChecked="True" Margin="0,0,0,8" />

                    <TextBlock x:Name="TxtTrayNotice" Text="QuickAudioSwitcher работает в фоновом режиме в системном трее возле часов."
                               FontSize="11" Foreground="{DynamicResource StudioTextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Separator 2 -->
                <Rectangle Grid.Column="3" Fill="{DynamicResource StudioBorderBrush}" Width="1" HorizontalAlignment="Center" Margin="0,2" />

                <!-- 3. Preferences (Language & Theme) block -->
                <StackPanel Grid.Column="4">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🎨" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtPrefsTitle" Text="Язык и внешний вид" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource StudioTextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Language Selector -->
                    <TextBlock x:Name="TxtLabelLanguage" Text="Язык интерфейса:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource StudioTextSecondaryBrush}" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnLangRu" Content="🇷🇺 Русский"
                                Style="{StaticResource ModernButtonStyle}"
                                Padding="6,5" FontSize="11" Margin="0,0,3,0"
                                Click="BtnLangRu_Click" />
                        <Button x:Name="BtnLangEn" Grid.Column="1" Content="🇬🇧 English"
                                Style="{StaticResource ModernButtonStyle}"
                                Padding="6,5" FontSize="11" Margin="3,0,0,0"
                                Click="BtnLangEn_Click" />
                    </Grid>

                    <!-- Theme Selector -->
                    <TextBlock x:Name="TxtLabelTheme" Text="Тема оформления:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource StudioTextSecondaryBrush}" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnThemeDark" Content="🌙 Тёмная"
                                Style="{StaticResource ModernButtonStyle}"
                                Padding="6,5" FontSize="11" Margin="0,0,3,0"
                                Click="BtnThemeDark_Click" />
                        <Button x:Name="BtnThemeLight" Grid.Column="1" Content="☀ Светлая"
                                Style="{StaticResource ModernButtonStyle}"
                                Padding="6,5" FontSize="11" Margin="3,0,0,0"
                                Click="BtnThemeLight_Click" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer Buttons -->
        <Grid Grid.Row="3">
            <Button x:Name="BtnRefresh" Content="🔄 Обновить список"
                    Style="{StaticResource ModernButtonStyle}"
                    HorizontalAlignment="Left" Padding="14,8"
                    Click="BtnRefresh_Click" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="Отмена"
                        Style="{StaticResource ModernButtonStyle}"
                        Margin="0,0,10,0" Padding="16,8"
                        Click="BtnCancel_Click" />
                <Button x:Name="BtnSave" Content="💾 Сохранить и применить"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="18,8"
                        Click="BtnSave_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
