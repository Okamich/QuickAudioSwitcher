<Window x:Class="QuickAudioSwitcher.UI.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickAudioSwitcher OSD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Sleek Studio ProgressBar Style -->
        <Style x:Key="StudioProgressBarStyle" TargetType="ProgressBar">
                <Setter Property="Height" Value="6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border Background="{DynamicResource StudioBorderHighlightBrush}" CornerRadius="3" SnapsToDevicePixels="True" />
                                <Border x:Name="PART_Track" CornerRadius="3" SnapsToDevicePixels="True" />
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" SnapsToDevicePixels="True">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#0284C7" Offset="0.0" />
                                            <GradientStop Color="#00E5FF" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
    </Window.Resources>

    <Border x:Name="ContainerBorder"
            Background="{DynamicResource StudioBgDarkBrush}"
            BorderBrush="{DynamicResource StudioBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="16,12"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.35" Color="#000000" />
        </Border.Effect>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Studio Icon Badge -->
            <Border Background="{DynamicResource StudioCardHoverBrush}"
                    BorderBrush="{DynamicResource StudioBorderHighlightBrush}"
                    BorderThickness="1"
                    CornerRadius="8" Padding="9,8" Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock Text="🔊" FontSize="20" Foreground="{DynamicResource StudioAccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Info block -->
            <StackPanel VerticalAlignment="Center" MinWidth="190">
                <TextBlock x:Name="TxtOsdTitle" Text="ВЫХОД ЗВУКА"
                           FontSize="10" FontWeight="Bold"
                           Foreground="{DynamicResource StudioAccentCyanBrush}" Margin="0,0,0,2"
                           FontFamily="Segoe UI, Segoe UI Variable Display" />

                <TextBlock x:Name="TxtDeviceName" Text="Монитор Левый"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource StudioTextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                           MaxWidth="300" />

                <Grid Margin="0,6,0,0">
                    <ProgressBar x:Name="PbVolume"
                                 Style="{StaticResource StudioProgressBarStyle}"
                                 Minimum="0" Maximum="100" Value="50" />
                </Grid>
            </StackPanel>

            <!-- Percent block -->
            <StackPanel VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="44">
                <TextBlock x:Name="TxtOsdVolume" Text="ГРОМКОСТЬ"
                           FontSize="9" FontWeight="Bold"
                           Foreground="{DynamicResource StudioTextMutedBrush}" HorizontalAlignment="Right" Margin="0,0,0,2" />
                <TextBlock x:Name="TxtVolumePercent" Text="50%"
                           FontSize="15" FontWeight="Bold" Foreground="{DynamicResource StudioTextPrimaryBrush}"
                           HorizontalAlignment="Right" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
