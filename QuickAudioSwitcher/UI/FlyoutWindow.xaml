<Window x:Class="QuickAudioSwitcher.UI.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickAudioSwitcher Menu"
        Icon="/Resources/app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="350"
        SizeToContent="Height"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource StudioBgDarkBrush}"
            BorderBrush="{DynamicResource StudioBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="0"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.5" Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <!-- Studio Header Strip -->
            <Grid Margin="16,14,14,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Studio Wave / Indicator Badge -->
                    <Border Background="{DynamicResource StudioCardHoverBrush}"
                            BorderBrush="{DynamicResource StudioBorderHighlightBrush}"
                            BorderThickness="1"
                            CornerRadius="4" Padding="6,3" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="2.5" Height="10" Fill="{DynamicResource StudioAccentCyanBrush}" RadiusX="1" RadiusY="1" Margin="0,0,2,0" />
                            <Rectangle Width="2.5" Height="14" Fill="{DynamicResource StudioAccentCyanBrush}" RadiusX="1" RadiusY="1" Margin="0,0,2,0" />
                            <Rectangle Width="2.5" Height="7" Fill="{DynamicResource StudioAccentCyanBrush}" RadiusX="1" RadiusY="1" Margin="0,0,2,0" />
                            <Rectangle Width="2.5" Height="12" Fill="{DynamicResource StudioAccentCyanBrush}" RadiusX="1" RadiusY="1" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="TxtHeaderTitle" Text="АУДИОВЫХОД"
                               FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource StudioTextPrimaryBrush}" VerticalAlignment="Center"
                               FontFamily="Segoe UI, Segoe UI Variable Display" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnSettings" Content="⚙ Настройки"
                            Style="{StaticResource ModernButtonStyle}"
                            Padding="8,4" FontSize="11" Margin="0,0,5,0"
                            Click="BtnSettings_Click" />
                    <Button x:Name="BtnClose" Content="✕"
                            Style="{StaticResource ModernButtonStyle}"
                            Padding="6,4" FontSize="11" Width="26"
                            Click="BtnClose_Click" />
                </StackPanel>
            </Grid>

            <Separator Background="{DynamicResource StudioBorderBrush}" Margin="0,0,0,8" />

            <!-- Favorites List -->
            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="10,0">
                <StackPanel x:Name="PnlFavorites" />
            </ScrollViewer>

            <!-- No favorites warning placeholder -->
            <Border x:Name="PnlNoFavorites"
                    Background="{DynamicResource StudioCardBgBrush}"
                    BorderBrush="{DynamicResource StudioBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6" Margin="12,8" Padding="12" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="TxtNoFavoritesTitle" Text="⚡ Нет избранных выходов"
                               FontWeight="SemiBold" Foreground="{DynamicResource StudioAccentAmberBrush}" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock x:Name="TxtNoFavoritesHint" Text="Откройте «⚙ Настройки» и отметьте нужные устройства звёздочкой для быстрого переключения."
                               TextWrapping="Wrap" Foreground="{DynamicResource StudioTextSecondaryBrush}" FontSize="11" LineHeight="16" />
                </StackPanel>
            </Border>

            <Separator Background="{DynamicResource StudioBorderBrush}" Margin="0,8,0,10" />

            <!-- Volume Control Fader Section -->
            <Border Background="{DynamicResource StudioCardBgBrush}"
                    BorderBrush="{DynamicResource StudioBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8" Margin="10,0,10,12" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnMute" Content="🔊"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource StudioAccentCyanBrush}" FontSize="18" Cursor="Hand"
                            VerticalAlignment="Center" Margin="0,0,10,0"
                            ToolTip="Включить / отключить звук"
                            Click="BtnMute_Click" />

                    <Slider x:Name="SliderVolume" Grid.Column="1"
                            Style="{StaticResource ModernSliderStyle}"
                            Minimum="0" Maximum="100" Value="50"
                            VerticalAlignment="Center"
                            ValueChanged="SliderVolume_ValueChanged" />

                    <TextBlock x:Name="TxtVolume" Grid.Column="2"
                               Text="50%" Foreground="{DynamicResource StudioTextPrimaryBrush}"
                               FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
